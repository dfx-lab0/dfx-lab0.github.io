@article{DU2026132607,
title = {PolypDiff: Controlled Diffusion Model for Polyp Segmentation and Image Generation},
journal = {Expert Systems with Applications},
pages = {132607},
year = {2026},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2026.132607},
url = {https://www.sciencedirect.com/science/article/pii/S0957417426015204},
author = {Feixiang Du and Zhongliang Wang and Joel C.M. Than and Hadi {Nabipour Afrouzi}},
keywords = {Polyp segmentation, Diffusion models, Data augmentation, Multi-stage estimator},
abstract = {Colorectal cancer is a highly lethal disease, and early detection of polyps through effective image segmentation is crucial for diagnosis. However, the limited size of existing polyp image datasets poses a significant challenge to training robust models. To overcome this, various data augmentation methods have been proposed to expand datasets and improve model generalization. Despite these advancements, challenges remain. For example, traditional background replacement techniques often result in unnatural-looking images. While methods based on Generative Adversarial Networks (GANs) and diffusion models have enhanced image quality, they struggle to ensure consistency between generated images and their corresponding labels. Moreover, these methods often fail to account for the close relationship between polyp structures and their surrounding environment, and lack effective mechanisms for assessing image quality. To address these challenges, this paper introduces a new framework for polyp image generation based on a controllable diffusion model, called PolypDiff. The framework consists of three core modules: (1) the Time-Perception Polyp-Context Relationship Learning Module (T-PCRLM); (2) the Time-Perception Extension and Restoration Module (T-ERM); and (3) the Multi-Stage Feature Consistency Estimator (MFCE). The three modules can extracts rich relational features, generates high-quality images and employs a multi-stage approach to evaluate the confidence of generated images at both the pixel level and in feature space respectively. Experimental results demonstrate that this framework significantly outperforms existing methods in terms of image quality, environmental consistency, and controllability. The generated polyp images not only enhance the performance of segmentation models but also exhibit exceptional diversity and feature consistency.}
}